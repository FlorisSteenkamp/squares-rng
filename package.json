{
    "name": "squares-rng",
    "sideEffects": false,
    "description": "Squares: A Fast Counter-Based RNG",
    "version": "2.0.4",
    "author": {
        "name": "Floris Steenkamp"
    },
    "license": "MIT",
    "type": "module",
    "main": "./node/index.js",
    "exports": "./node/index.js",
    "engines": {
        "node": "^12.20.0 || ^14.13.1 || >=16.0.0"
    },
    "private": false,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/FlorisSteenkamp/squares-rng.git"
    },
    "bugs": {
        "url": "https://github.com/FlorisSteenkamp/squares-rng/issues"
    },
    "keywords": [
        "Fast",
        "Counter-Based",
        "RNG",
        "Random",
        "Number",
        "Generator",
        "Middle",
        "Square",
        "Method",
        "Bernard",
        "Widynski"
    ],
    "devDependencies": {
        "@assemblyscript/loader": "^0.28.16",
        "@types/chai": "^5.2.3",
        "@types/mocha": "^10.0.10",
        "@types/node": "^25.6.0",
        "assemblyscript": "^0.28.16",
        "chai": "^6.2.2",
        "mocha": "^11.7.5",
        "rimraf": "^6.1.3",
        "ts-loader": "^9.5.7",
        "ts-node": "^10.9.2",
        "typescript": "^6.0.3",
        "webpack": "^5.106.2",
        "webpack-cli": "^7.0.2"
    },
    "scripts": {
        "build": "npm run build-browser && npm run build-node",
        "build-wasm": "asc --runtime none --converge --optimizeLevel 3 --shrinkLevel 2 --binaryFile index.wasm --textFile index.wat assembly/index.ts",
        "build-node": "rimraf node && tsc",
        "build-browser": "rimraf browser && webpack --mode production",
        "test": "mocha",
        "coverage": "c8 mocha",
        "test-package": "npm pack"
    }
}
